{
  "manifest_version": 3,
  "name": "Little List",
  "version": "1.0.1",
  "description": "A quiet place for things to do. A simple to-do list that syncs through your Google account in Chrome.",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage"
  ],
  "key": "",
  "action": {
    "default_title": "Little List",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
